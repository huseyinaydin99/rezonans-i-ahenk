<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_1.xsd"
                 version="3.1">
    
    <entity class="tr.com.huseyinaydin.domain.artist.Artist" name="Artist" access="FIELD">
        <table name="artists"/>
        <attributes>
            <basic name="name">
                <column name="name" nullable="false"/>
            </basic>
            <basic name="imageUrl">
                <column name="image_url"/>
            </basic>
            <basic name="bio">
                <column name="bio"/>
            </basic>
            <basic name="monthlyListeners">
                <column name="monthly_listeners" nullable="false"/>
            </basic>
            <basic name="isVerified">
                <column name="is_verified" nullable="false"/>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
