<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm_3_0.xsd"
                 version="3.0">

    <description>Music Platform Complete Pure Domain XML Mappings</description>
    <package>tr.com.huseyinaydin.domain</package>

    <!-- SONG MAPPING -->
    <entity class="song.Song" name="Song">
        <table name="songs"/>
        <attributes>
            <id name="id"><column name="id" column-definition="UUID"/></id>
            <basic name="title"><column name="title" nullable="false" length="255"/></basic>
            <basic name="coverImageUrl"><column name="cover_image_url" length="500"/></basic>
            <basic name="audioUrl"><column name="audio_url" nullable="false" length="500"/></basic>
            <basic name="duration"><column name="duration_seconds" nullable="false"/></basic>
            <basic name="tier">
                <column name="membership_tier" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="releaseDate"><column name="release_date" nullable="false"/></basic>
            <basic name="artistId"><column name="artist_id" nullable="false" column-definition="UUID"/></basic>
            <basic name="genreId"><column name="genre_id" nullable="false" column-definition="UUID"/></basic>
            <basic name="playCount"><column name="play_count" nullable="false"/></basic>
        </attributes>
    </entity>

    <!-- ARTIST MAPPING -->
    <entity class="artist.Artist" name="Artist">
        <table name="artists"/>
        <attributes>
            <id name="id"><column name="id" column-definition="UUID"/></id>
            <basic name="name"><column name="name" nullable="false" length="255"/></basic>
            <basic name="bio"><column name="bio" length="2000"/></basic>
            <basic name="profileImageUrl"><column name="profile_image_url" length="500"/></basic>
            <basic name="followerCount"><column name="follower_count" nullable="false"/></basic>
        </attributes>
    </entity>

    <!-- PLAYLIST MAPPING -->
    <entity class="playlist.Playlist" name="Playlist">
        <table name="playlists"/>
        <attributes>
            <id name="id"><column name="id" column-definition="UUID"/></id>
            <basic name="name"><column name="name" nullable="false" length="255"/></basic>
            <basic name="description"><column name="description" length="1000"/></basic>
            <basic name="ownerId"><column name="owner_id" nullable="false" column-definition="UUID"/></basic>
        </attributes>
    </entity>

    <!-- GENRE MAPPING -->
    <entity class="genre.Genre" name="Genre">
        <table name="genres"/>
        <attributes>
            <id name="id"><column name="id" column-definition="UUID"/></id>
            <basic name="name"><column name="name" nullable="false" length="255"/></basic>
            <basic name="imageUrl"><column name="image_url" length="500"/></basic>
        </attributes>
    </entity>

</entity-mappings>
